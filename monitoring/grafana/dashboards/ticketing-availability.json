        {
          "expr": "probe_duration_seconds{probe=~\"healthz|readyz\"}",
          "legendFormat": "{{probe}}",
          "refId": "A"
        }
      ],
      "description": "Response duration observed while probing /healthz and /readyz.",
      "title": "Availability — Health endpoint latency",
      "type": "timeseries"
    },
