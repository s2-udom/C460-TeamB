# Flask
FLASK_APP=run.py
FLASK_RUN_PORT=5000
FLASK_ENV=development
SECRET_KEY=change-this-for-local-development

# Database (matches the db service in docker-compose.yml)
# A plain postgresql:// URL is fine; app/config.py adds the psycopg driver.
DATABASE_URL=postgresql://ticketing:ticketing_dev_password@127.0.0.1:5432/ticketing

# Optional application settings
HOLD_DURATION_MINUTES=10

# Local Grafana login (change before sharing the monitoring UI)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-before-sharing

# Host ports for this project's monitoring UI (9090/3000 may already be in use)
PROMETHEUS_PORT=9091
GRAFANA_PORT=3001
